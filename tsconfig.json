{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext"],
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "types": ["bun"],
    "allowSyntheticDefaultImports": true,

    "paths": {
      "@services/*": ["./src/services/*"],
      "@config/*": ["./src/config/*"],
      "@models/*": ["./src/models/*"],
      "@db/*": ["./src/db/*"]
    }
  },
  "include": ["src/**/*", "api/**/*", "server.ts"],
  "exclude": ["node_modules", "dist"]
}
